<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="add-public-page" author="commafeed">
		<addColumn tableName="USERS">
			<column name="public_page_enabled" type="BOOLEAN" valueBoolean="false">
				<constraints nullable="false" />
			</column>
			<column name="public_page_uncategorized" type="BOOLEAN" valueBoolean="false">
				<constraints nullable="false" />
			</column>
		</addColumn>
		<addColumn tableName="FEEDCATEGORIES">
			<column name="public_category" type="BOOLEAN" valueBoolean="false">
				<constraints nullable="false" />
			</column>
		</addColumn>
	</changeSet>

	<changeSet id="add-public-page-token" author="commafeed">
		<addColumn tableName="USERS">
			<column name="public_page_token" type="VARCHAR(64)">
				<constraints nullable="true" unique="true" />
			</column>
		</addColumn>
	</changeSet>

</databaseChangeLog>
